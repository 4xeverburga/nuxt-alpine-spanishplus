{
  "name": "@4xeverburga/alpine-spanishplus",
  "version": "3.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/4xeverburga/nuxt-alpine-spanishplus.git"
  },
  "exports": "./nuxt.config.ts",
  "packageManager": "pnpm@8.5.1",
  "files": [
    "app",
    "assets",
    "components",
    "i18n",
    "types",
    "app.config.ts",
    "nuxt.config.ts",
    "tokens.config.ts"
  ],
  "scripts": {
    "prepare": "nuxi prepare && nuxi prepare .starters/default",
    "dev": "nuxi dev .starters/default",
    "build": "nuxi build .starters/default",
    "generate": "nuxi generate .starters/default",
    "preview": "nuxi preview .starters/default",
    "lint": "eslint .",
    "release": "release-it"
  },
  "dependencies": {
    "@nuxt-themes/elements": "^0.9.5",
    "@nuxt-themes/tokens": "^1.9.1",
    "@nuxt-themes/typography": "^0.11.0",
    "@nuxt/content": "^3.15.0",
    "@nuxt/icon": "^2.3.1",
    "@nuxtjs/i18n": "^10.4.1",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.7.0",
    "nuxt": "^4.4.8",
    "release-it": "^16.3.0",
    "typescript": "^5.3.3",
    "vite-plugin-inspect": "^0.8.1",
    "vue": "^3.5.34"
  },
  "pnpm": {
    "overrides": {},
    "peerDependencyRules": {
      "allowedVersions": {
        "axios": "0.25.0",
        "vite": "*"
      },
      "ignoreMissing": [
        "postcss",
        "postcss-*",
        "webpack",
        "axios",
        "vite",
        "@nuxt/vite-builder"
      ]
    }
  },
  "license": "MIT",
  "release-it": {
    "npm": {
      "access": "public"
    },
    "git": {
      "commitMessage": "chore(release): release v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}"
    }
  }
}
